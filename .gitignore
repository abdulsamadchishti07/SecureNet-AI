# Environment & Secrets
.venv/
venv/
env/
.env
.env.*

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
reports/tests/

# Datasets (large files > 100MB)
dataset/raw/*.csv
dataset/processed/*.csv
*.csv

# Model weights, pickles, and large serialization dumps
ml_engine/models/*.pkl
ml_engine/models/*.joblib
ml_engine/models/*.h5
ml_engine/models/*.onnx
*.pkl

# Corrected Friday runtime artifacts (reports are kept separately)
ml_engine/models/friday_v2/
ml_engine/models/thursday_v1/
ml_engine/models/wednesday_v1/
ml_engine/models/tuesday_v1/
ml_engine/models/unified_v1/

# Keep folder structures
!**/models/.gitkeep
!**/dataset/**/.gitkeep

# Logs and runtime files
*.log
*.pcap
runtime/

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
