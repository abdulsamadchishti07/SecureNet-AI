# Prefer: python -m backend.manage init-config --database-url sqlite:///./runtime/securenet.sqlite3
# Generate independent random secrets; the backend rejects missing/insecure keys.
DATABASE_URL=sqlite:///./runtime/securenet.sqlite3
SECRET_KEY=
SENSOR_API_TOKEN=
SENSOR_ID=sensor-local
# Comma-separated explicit dashboard origins. Empty disables browser cross-origin access.
CORS_ORIGINS=
