# Prefer: python -m backend.manage init-config --database-url sqlite:///./runtime/securenet.sqlite3
# Generate independent random secrets; the backend rejects missing/insecure keys.
DATABASE_URL=sqlite:///./runtime/securenet.sqlite3
SECRET_KEY=
SENSOR_API_TOKEN=
SENSOR_ID=sensor-local
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=15
# Comma-separated explicit dashboard origins. Empty disables browser cross-origin access.
CORS_ORIGINS=

# Notifications run in the sensor's response worker, not the API container.
# Explicit opt-in; with no channel configured, accepted notifications are logged.
ALERT_NOTIFICATIONS_ENABLED=false
ALERT_INCLUDE_DRY_RUN=false
ALERT_COOLDOWN_SECONDS=600
ALERT_MAX_PER_HOUR=30
ALERT_QUEUE_SIZE=64
SMTP_HOST=
SMTP_PORT=587
# starttls, ssl, or plain (plain only permits a loopback development server).
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
ALERT_EMAIL_RECIPIENT=
ALERT_WEBHOOK_URL=
# generic, slack, discord
ALERT_WEBHOOK_FORMAT=generic
